{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MindSpace Harness Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "currentPhase", "sources", "requiredDocuments", "validation"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "project": { "const": "MindSpace" },
    "currentPhase": { "type": "string", "minLength": 1 },
    "sources": { "type": "object" },
    "requiredDocuments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "validation": { "type": "object" }
  }
}
