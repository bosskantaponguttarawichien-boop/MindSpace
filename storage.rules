rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // `write` also covers delete, where `request.resource` is null. Size and type conditions must
    // therefore stay on create/update, or every cleanup delete is rejected as unauthorized.
    match /users/{userId}/images/{imageId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // The UUID workspace ID in the private sync URL is the edit capability.
    match /workspaces/{workspaceId}/images/{imageId} {
      allow read, delete: if workspaceId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
      allow create, update: if workspaceId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
